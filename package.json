{
  "name": "electronuxt",
  "description": "",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./.electron/dist/main/index.js",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p electron/tsconfig.json --noEmit",
    "prepare": "husky",
    "fmt": "oxfmt && oxfmt --check",
    "lint": "oxlint",
    "release": "node ./scripts/release.ts",
    "dev:electron": "node ./scripts/electron-dev.ts",
    "build:electron": "electron-vite build",
    "package": "pnpm run build && pnpm run build:electron && electron-builder"
  },
  "dependencies": {
    "@lucide/vue": "^1.38.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.4",
    "shadcn-nuxt": "^2.8.2",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@iconify-json/lucide": "^1.2.128",
    "@iconify-json/lucide-lab": "^1.2.3",
    "@iconify/vue": "^5.0.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "changelogen": "^0.6.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.20.0"
}
